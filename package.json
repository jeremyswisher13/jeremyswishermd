{
  "name": "swishermd-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "validate": "npm run validate:site && npm run validate:schema && npm run validate:hep-content && npm run validate:hep-videos && npm run validate:sitemap",
    "validate:site": "node scripts/validate-site-integrity.mjs",
    "validate:schema": "node scripts/validate-structured-data.mjs",
    "validate:hep-content": "node scripts/validate-hep-content.mjs",
    "validate:hep-videos": "node scripts/validate-hep-videos.mjs",
    "validate:sitemap": "node scripts/sync-sitemap-dates.mjs --check",
    "test": "npm run test:rendered",
    "test:rendered": "playwright test",
    "test:print-pdf": "node scripts/export-hep-pdfs.mjs && python3 -B scripts/validate-hep-pdfs.py .quality-results/print",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "test:quality": "npm run validate && npm run test:rendered && npm run test:print-pdf && npm run test:lighthouse"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1"
  }
}
